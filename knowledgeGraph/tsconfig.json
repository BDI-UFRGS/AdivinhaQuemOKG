{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "lib": ["es2020", "dom"],
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
